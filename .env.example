# Placeholder format only. Never commit a real MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/sri_lanka_news?retryWrites=true&w=majority
# Shared only with the ingestion service. Generate a long random local value.
INGESTION_API_KEY=<strong-random-shared-secret>
# Supabase Auth uses asymmetric signing keys exposed through this JWKS endpoint.
SUPABASE_AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_AUTH_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUTH_AUDIENCE=authenticated
# Provider-neutral Redis connection URL. Never commit the real URL or credentials.
REDIS_URL=rediss://:<password>@<redis-host>:<port>
# Public article feed cache TTL in seconds. Cached entries always expire.
ARTICLE_FEED_CACHE_TTL_SECONDS=60
# Maximum recent Articles ranked per personalized feed request.
FOR_YOU_CANDIDATE_LIMIT=500
# Deterministic Story clustering controls.
STORY_CLUSTER_WINDOW_HOURS=48
STORY_CLUSTER_THRESHOLD=0.72
STORY_CLUSTER_CANDIDATE_LIMIT=200
STORY_CLUSTER_BACKFILL_LIMIT=100
# Private semantic Story embedding controls.
STORY_EMBEDDING_MODEL=gemini-embedding-2
STORY_EMBEDDING_DIMENSIONS=768
STORY_EMBEDDING_MAX_INPUT_CHARACTERS=8000
STORY_SEMANTIC_THRESHOLD=0.82
STORY_CROSS_LANGUAGE_SEMANTIC_THRESHOLD=0.90
STORY_EMBEDDING_BACKFILL_LIMIT=50
# Public semantic search reuses the private Article vectors above.
SEMANTIC_SEARCH_VECTOR_INDEX=idx_articles_semantic_vector
SEMANTIC_SEARCH_MIN_SCORE=0.65
SEMANTIC_SEARCH_MAX_WINDOW=200
# Guest-accessible, Story-scoped grounded-answer limits. No questions or answers are persisted.
ASK_STORY_PROMPT_VERSION=ask-story-v1
ASK_STORY_MAX_QUESTION_CHARACTERS=500
ASK_STORY_MAX_RETRIEVED_ARTICLES=5
ASK_STORY_MAX_ARTICLE_CONTEXT_CHARACTERS=6000
ASK_STORY_MAX_TOTAL_CONTEXT_CHARACTERS=24000
ASK_STORY_MAX_ANSWER_CHARACTERS=3000
# Deterministic public Trending ranking. No user activity, AI, or Redis is used.
TRENDING_WINDOW_HOURS=72
TRENDING_RECENCY_HALF_LIFE_HOURS=12
TRENDING_SOURCE_NORMALIZATION=3
TRENDING_REPORT_NORMALIZATION=5
TRENDING_MAX_CANDIDATES=500
# Google AI Studio key and configurable Gemini model identifier.
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=<gemini-model-id>
# Translation uses the same Gemini client but has independent idempotency/version controls.
MULTILINGUAL_MODEL=<gemini-model-id>
MULTILINGUAL_PROMPT_VERSION=translation-v1
MULTILINGUAL_MAX_INPUT_CHARACTERS=8000
# Set to 0 to disable bounded startup translation backfill.
MULTILINGUAL_BACKFILL_LIMIT=10
