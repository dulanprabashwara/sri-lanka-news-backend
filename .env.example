# Placeholder format only. Never commit a real MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/sri_lanka_news?retryWrites=true&w=majority
# Shared only with the ingestion service. Generate a long random local value.
INGESTION_API_KEY=<strong-random-shared-secret>
# Provider-neutral Redis connection URL. Never commit the real URL or credentials.
REDIS_URL=rediss://:<password>@<redis-host>:<port>
# Public article feed cache TTL in seconds. Cached entries always expire.
ARTICLE_FEED_CACHE_TTL_SECONDS=60
# Deterministic Story clustering controls.
STORY_CLUSTER_WINDOW_HOURS=48
STORY_CLUSTER_THRESHOLD=0.72
STORY_CLUSTER_CANDIDATE_LIMIT=200
STORY_CLUSTER_BACKFILL_LIMIT=100
# Google AI Studio key and configurable Gemini model identifier.
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=<gemini-model-id>
